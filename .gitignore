# --- Corpus: input photos are personal and bulky. Manifest is tracked, images are not.
# corpus/**
!corpus/manifest.csv
!corpus/.gitkeep

# --- Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# --- ONNX / model weights (downloaded on demand, never committed)
*.onnx
.u2net/

# --- Flutter / Dart
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/ios/Pods/
app/ios/.symlinks/
app/android/.gradle/
app/android/local.properties
*.iml

# --- Service
service/.env
*.sqlite
*.db

# --- OS / editor
.DS_Store
Thumbs.db
*.swp

# Scratch benchmarks and caches (in-workspace because /tmp does not persist
# between tool invocations in the sandbox)
pipeline/scratch/
pipeline/.cache/

# Face detector model (downloaded on demand)
pipeline/.cache/models/

# Artifact bundles written by `pbn convert --artifacts`
artifacts/

# Comparison / experiment output folders
out-stylised/
out-stylise-compare/
out-upscale-test/

.batch1/
.batch2/

# Service runtime data and venv
service/.data/
service/.venv/
service/.data-server.log

# Guard against the nested project path reappearing. flutter create was originally run
# from inside app/, producing app/app/, and generated files committed from there escaped
# Flutter own ignore rules which live at app/ios/.gitignore and app/android/.
app/app/
